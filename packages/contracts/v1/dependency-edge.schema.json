{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-nexus.local/contracts/v1/dependency-edge.schema.json",
  "title": "DependencyEdge",
  "type": "object",
  "additionalProperties": false,
  "required": ["edgeId", "source", "target", "relationshipType", "consumerOwnerReference", "declarationOrigin", "analyzerVersion"],
  "properties": {
    "edgeId": { "type": "string", "minLength": 1 },
    "source": { "$ref": "artifact-version.schema.json" },
    "target": { "$ref": "artifact-version.schema.json" },
    "targetVersionConstraint": { "type": "string", "minLength": 1 },
    "relationshipType": { "type": "string", "enum": ["runtime", "governance"] },
    "consumerOwnerReference": { "type": "string", "minLength": 1 },
    "declarationOrigin": { "type": "string", "minLength": 1 },
    "sourceRepositoryLocation": { "type": "string", "minLength": 1 },
    "analyzerVersion": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 }
  }
}
