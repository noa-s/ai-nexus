{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-nexus.local/contracts/v1/dependency-target.schema.json",
  "title": "DependencyTarget",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "artifactId"],
  "properties": {
    "artifactType": { "type": "string", "enum": ["agent", "prompt", "policy", "knowledge", "tool", "model-capability", "evaluation-suite", "platform-component"] },
    "artifactId": { "type": "string", "minLength": 1 }
  }
}
